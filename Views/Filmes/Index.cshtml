@model IEnumerable<Cine99.Models.Filme>
@{
    ViewData["Title"] = "Catálogo de Filmes";
}
<h2>🎬 Catálogo de Filmes</h2>

@if (User.Identity!.IsAuthenticated)
{
    <a asp-action="Create" class="btn btn-primary mb-3">
        + Adicionar Filme
    </a>
}

<div class="row">
@foreach (var filme in Model)
{
    var nota = filme.Avaliacoes.Any()
        ? filme.Avaliacoes.Average(a => a.Nota).ToString("0.0")
        : "Sem avaliação";

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            @if (!string.IsNullOrEmpty(filme.ImagemUrl))
            {
                <img src="@filme.ImagemUrl" class="card-img-top"
                     style="height:300px;object-fit:cover" />
            }
            <div class="card-body">
                <h5 class="card-title">@filme.Nome</h5>
                <p class="text-muted">@filme.Diretor — @filme.AnoLancamento</p>
                <p class="card-text">@(filme.Sinopse.Length > 100
                    ? filme.Sinopse.Substring(0,100) + "..."
                    : filme.Sinopse)</p>
                <span class="badge bg-warning text-dark fs-6">
                    ⭐ @nota
                </span>
            </div>
            <div class="card-footer">
                <a asp-action="Details" asp-route-id="@filme.Id"
                   class="btn btn-outline-primary btn-sm">Ver Detalhes</a>
            </div>
        </div>
    </div>
}
</div>